DATABASE_URL="postgresql://inventario:inventario@localhost:5432/inventario_despachos?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000

# WhatsApp Business API (Meta) - completar cuando la cuenta esté aprobada
WHATSAPP_VERIFY_TOKEN="change-me"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Resend (recuperación de contraseña por email) - sin esta key, el link de
# reseteo se imprime en la consola del servidor en vez de enviarse de verdad.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# URL del frontend, usada para armar el link del email de recuperación
FRONTEND_URL="http://localhost:5173"
