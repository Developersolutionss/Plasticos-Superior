generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Matriz de roles completa (Módulo 1). Reemplaza los 3 roles iniciales
/// (produccion/despacho/admin) — la migración de datos existente vive en
/// server/prisma/migrations/*_expand_role_matrix/migration.sql.
enum UserRole {
  super_admin
  admin
  gerente_produccion
  planeacion
  ventas_pedidos
  operario_extrusion
  operario_impresion
  operario_sellado_precorte
  calidad
  almacen_despachos
  auditor
}

enum ProductCategory {
  bultos
  rollos_prec_lam
  rollos_fuelle
  mangueta
  tiras
  control_impresion
}

enum ProductUnit {
  kg
  unidad
}

enum ProductionStatus {
  pendiente
  en_transito
  recibido
  rechazado
}

enum ProductionSource {
  manual
  excel_import
  whatsapp_bot
}

enum MovementType {
  entrada_produccion
  salida_despacho
  ajuste
  devolucion
}

enum ReferenceType {
  production_entry
  dispatch_item
  manual_adjustment
}

enum DispatchStatus {
  pendiente
  en_proceso
  despachado
}

enum ImportSource {
  manual_upload
  whatsapp_bot
}

enum ProductionOrderStatus {
  pendiente
  en_proceso
  pendiente_calidad
  detenida
  finalizada
  cancelada
}

enum ProductionStation {
  extrusion
  impresion
  sellado
  precorte
}

enum QualityResult {
  aprobado
  rechazado
}

enum InteractionType {
  llamada
  email
  reunion
  nota
}

enum CotizacionStatus {
  borrador
  enviada
  aceptada
  rechazada
  expirada
}

enum PedidoStatus {
  borrador
  pendiente
  aprobado
  en_produccion
  despachado
  cancelado
}

enum FacturaStatus {
  emitida
  pagada_parcial
  pagada
  anulada
}

enum PaymentMethod {
  efectivo
  transferencia
  cheque
  tarjeta
  otro
}

model User {
  id            Int               @id @default(autoincrement())
  name          String
  email         String            @unique
  passwordHash  String            @map("password_hash")
  role          UserRole
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now()) @map("created_at")

  /// Bloqueo por intentos fallidos: se incrementa en cada password
  /// incorrecto, se resetea en un login exitoso. Al llegar al umbral
  /// (ver auth.ts) se completa lockedUntil y el login se rechaza hasta
  /// esa fecha aunque la contraseña sea correcta.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  /// 2FA opcional (TOTP). El secret se genera en /2fa/setup pero
  /// twoFactorEnabled queda en false hasta que el usuario confirma un
  /// código válido en /2fa/verify — evita que alguien quede bloqueado
  /// de su propia cuenta por una vinculación a medias.
  twoFactorSecret  String?  @map("two_factor_secret")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")

  passwordResetTokens PasswordResetToken[]

  productionEntries ProductionEntry[]
  inventoryMovements InventoryMovement[]
  dispatches        Dispatch[]
  importLogs        ImportLog[]
  productionOrders     ProductionOrder[]
  productionRolls      ProductionRoll[]
  productionOrderAttachments ProductionOrderAttachment[]
  clientInteractions   ClientInteraction[]
  cotizaciones         Cotizacion[]
  pedidos              Pedido[]
  pedidoVersions       PedidoVersion[]
  pedidoAttachments    PedidoAttachment[]
  facturas             Factura[]
  payments             Payment[]
  qualityChecks        QualityCheck[]
  auditLogs            AuditLog[]
  warehouseStockUpdates StockLocation[]
  notifications         Notification[]

  @@map("users")
}

/// Notificación in-app. `type` es texto libre (ej. "op_pendiente_calidad")
/// para no tener que migrar el schema cada vez que se agrega un disparador
/// nuevo — el frontend solo necesita mostrar `message`/`link`.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@map("notifications")
}

model Product {
  id        Int             @id @default(autoincrement())
  sku       String          @unique
  name      String
  category  ProductCategory
  measure   String?
  unit      ProductUnit
  minStock  Decimal         @default(0) @map("min_stock") @db.Decimal(12, 2)
  unitPrice Decimal         @default(0) @map("unit_price") @db.Decimal(12, 2)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")

  productionEntries  ProductionEntry[]
  inventoryMovements InventoryMovement[]
  dispatchItems      DispatchItem[]
  stock              InventoryStock?
  productionOrders   ProductionOrder[]
  cotizacionItems    CotizacionItem[]
  pedidoVersionItems PedidoVersionItem[]
  facturaItems       FacturaItem[]
  stockLocations     StockLocation[]

  @@map("products")
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  contactInfo Json?    @map("contact_info")
  /// Límite de crédito manual (module "Cartera"). No hay facturación/pagos
  /// todavía, así que por ahora es un tope de referencia editable a mano,
  /// no un saldo calculado automáticamente.
  creditLimit Decimal? @default(0) @map("credit_limit") @db.Decimal(12, 2)
  /// Foto de perfil del cliente: ruta pública (/api/uploads/clients/<archivo>).
  avatarUrl String? @map("avatar_url")
  /// Conteo de veces que se abrió la ficha del cliente (filtro "Frecuentes").
  viewCount     Int       @default(0) @map("view_count")
  lastViewedAt  DateTime? @map("last_viewed_at")
  /// Interacciones (visitas) acumuladas desde la última purga semanal. Cuando
  /// llegan al umbral (5) el cliente se vuelve "hot" y su `viewCount` salta
  /// arriba del ranking en vivo; el boost se consume y el contador vuelve a 0
  /// (ver frecuentesReset.ts).
  cycleInteractions Int @default(0) @map("cycle_interactions")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  productionEntries ProductionEntry[]
  dispatches        Dispatch[]
  contacts          ClientContact[]
  addresses         ClientAddress[]
  interactions      ClientInteraction[]
  cotizaciones      Cotizacion[]
  pedidos           Pedido[]
  facturas          Factura[]
  productionOrders  ProductionOrder[]

  @@map("clients")
}

/// Direcciones de entrega del cliente (un cliente puede tener varias
/// bodegas/sucursales). `isPrimary` marca la dirección por defecto.
model ClientAddress {
  id         Int      @id @default(autoincrement())
  clientId   Int      @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id])
  label      String
  addressLine String  @map("address_line")
  city       String?
  region     String?
  postalCode String?  @map("postal_code")
  isPrimary  Boolean  @default(false) @map("is_primary")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("client_addresses")
}

/// Historial de interacciones comerciales con el cliente (llamadas,
/// correos, reuniones, notas internas), para que Ventas tenga contexto
/// sin depender de la memoria de una persona.
model ClientInteraction {
  id          Int              @id @default(autoincrement())
  clientId    Int              @map("client_id")
  client      Client           @relation(fields: [clientId], references: [id])
  type        InteractionType
  description String
  createdById Int?             @map("created_by")
  createdBy   User?            @relation(fields: [createdById], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("client_interactions")
}

model ClientContact {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  /// Conteo de veces que se abrió la ficha del contacto. Frecuencia PROPIA del
  /// contacto, independiente de la del cliente (mismo motor que Client).
  viewCount          Int       @default(0) @map("view_count")
  lastViewedAt       DateTime? @map("last_viewed_at")
  /// Interacciones acumuladas desde la última purga semanal. Al llegar al
  /// umbral (5) el contacto se vuelve "hot" y su `viewCount` salta arriba del
  /// ranking en vivo; el boost se consume y el contador vuelve a 0.
  cycleInteractions    Int       @default(0) @map("cycle_interactions")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("client_contacts")
}

model ProductionEntry {
  id           Int               @id @default(autoincrement())
  productId    Int               @map("product_id")
  product      Product           @relation(fields: [productId], references: [id])
  labelCode    String?           @map("label_code")
  operatorName String            @map("operator_name")
  clientId     Int?              @map("client_id")
  client       Client?           @relation(fields: [clientId], references: [id])
  measure      String?
  kilos        Decimal           @db.Decimal(12, 2)
  driverName   String?           @map("driver_name")
  status       ProductionStatus  @default(pendiente)
  source       ProductionSource  @default(manual)
  observations String?
  createdById  Int?              @map("created_by")
  createdBy    User?             @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now()) @map("created_at")

  movements InventoryMovement[]

  @@map("production_entries")
}

model InventoryMovement {
  id            Int            @id @default(autoincrement())
  productId     Int            @map("product_id")
  product       Product        @relation(fields: [productId], references: [id])
  movementType  MovementType   @map("movement_type")
  quantity      Decimal        @db.Decimal(12, 2)
  referenceType ReferenceType  @map("reference_type")
  referenceId   Int?           @map("reference_id")
  productionEntryId Int?       @map("production_entry_id")
  productionEntry   ProductionEntry? @relation(fields: [productionEntryId], references: [id])
  createdById   Int?           @map("created_by")
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")

  @@map("inventory_movements")
}

model InventoryStock {
  productId       Int      @id @map("product_id")
  product         Product  @relation(fields: [productId], references: [id])
  currentQuantity Decimal  @default(0) @map("current_quantity") @db.Decimal(12, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("inventory_stock")
}

/// Ubicación física de bodega (estante, rack, zona). El stock total de un
/// producto sigue viviendo en InventoryStock; esto es la capa de "dónde
/// está guardado", administrada a mano por Almacén (ver StockLocation).
model WarehouseLocation {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  /// Token aleatorio (32 hex) que codifica el QR imprimible de esta
  /// ubicación. Es la única "credencial" de /api/public/locations/:token —
  /// a propósito no es el `code` (corto y adivinable) para que ver el stock
  /// de una ubicación requiera haber escaneado ese QR físico puntual.
  publicToken String   @unique @map("public_token")
  createdAt   DateTime @default(now()) @map("created_at")

  stock StockLocation[]

  @@map("warehouse_locations")
}

/// Cuánto de un producto hay en una ubicación puntual. Un producto puede
/// estar repartido en varias filas; la suma de todas sus filas puede ser
/// menor al stock total de InventoryStock — la diferencia es "sin ubicar".
model StockLocation {
  id          Int               @id @default(autoincrement())
  productId   Int               @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  locationId  Int               @map("location_id")
  location    WarehouseLocation @relation(fields: [locationId], references: [id])
  quantity    Decimal           @default(0) @db.Decimal(12, 2)
  updatedById Int?              @map("updated_by")
  updatedBy   User?             @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([productId, locationId])
  @@map("stock_locations")
}

model Dispatch {
  id             Int            @id @default(autoincrement())
  clientId       Int            @map("client_id")
  client         Client         @relation(fields: [clientId], references: [id])
  status         DispatchStatus @default(pendiente)
  requestedDate  DateTime       @default(now()) @map("requested_date")
  dispatchedDate DateTime?      @map("dispatched_date")
  createdById    Int?           @map("created_by")
  createdBy      User?          @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now()) @map("created_at")

  items DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id                 Int      @id @default(autoincrement())
  dispatchId         Int      @map("dispatch_id")
  dispatch           Dispatch @relation(fields: [dispatchId], references: [id])
  productId          Int      @map("product_id")
  product            Product  @relation(fields: [productId], references: [id])
  quantityRequested  Decimal  @map("quantity_requested") @db.Decimal(12, 2)
  quantityDispatched Decimal? @map("quantity_dispatched") @db.Decimal(12, 2)
  labelCode          String?  @map("label_code")
  notes              String?

  @@map("dispatch_items")
}

model ImportLog {
  id            Int          @id @default(autoincrement())
  filename      String
  source        ImportSource
  rowsProcessed Int          @default(0) @map("rows_processed")
  rowsFailed    Int          @default(0) @map("rows_failed")
  uploadedById  Int?         @map("uploaded_by")
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("import_logs")
}

enum AuditAction {
  create
  update
  delete
}

/// Auditoría forense genérica: registra create/update/delete sobre las
/// tablas críticas (ver AUDITED_MODELS en server/src/services/
/// auditExtension.ts) con el estado antes/después y quién lo hizo desde
/// dónde. La escribe automáticamente la extensión de Prisma en prisma.ts,
/// no se crea a mano desde ningún router.
model AuditLog {
  id        Int         @id @default(autoincrement())
  tableName String      @map("table_name")
  recordId  Int?        @map("record_id")
  action    AuditAction
  before    Json?
  after     Json?
  userId    Int?        @map("user_id")
  user      User?       @relation(fields: [userId], references: [id])
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([tableName, recordId])
  @@map("audit_logs")
}

/// Orden de Producción (OP): una por proceso de planta (los formatos en papel
/// del cliente: F-OP-01 Extrusión, F-SE-01 Impresión/Sellado/Precorte). La
/// Extrusión es el proceso base; de ella se derivan OPs de Impresión, Sellado
/// o Precorte (y de Impresión, Sellado o Precorte) — `parentOrderId` guarda
/// esa cadena. `specs` lleva el encabezado de la plantilla de cada estación
/// (materia prima con %, medidas, montaje, colores, etc.) como JSON porque
/// cada formato tiene campos distintos.
/// `pedidoVersionItemId` es opcional: las OP creadas manualmente (sin pasar
/// por Planeación) siguen sin vínculo, igual que hasta ahora.
model ProductionOrder {
  id                  Int                   @id @default(autoincrement())
  orderNumber         String                @unique @map("order_number")
  station             ProductionStation     @default(extrusion)
  productId           Int                   @map("product_id")
  product             Product               @relation(fields: [productId], references: [id])
  clientId            Int?                  @map("client_id")
  client              Client?               @relation(fields: [clientId], references: [id])
  quantityPlanned     Decimal               @map("quantity_planned") @db.Decimal(12, 2)
  measure             String?
  status              ProductionOrderStatus @default(pendiente)
  specs               Json?
  notes               String?
  parentOrderId       Int?                  @map("parent_order_id")
  parent              ProductionOrder?      @relation("OrderDerivation", fields: [parentOrderId], references: [id])
  derivedOrders       ProductionOrder[]     @relation("OrderDerivation")
  pedidoVersionItemId Int?                  @unique @map("pedido_version_item_id")
  pedidoVersionItem   PedidoVersionItem?    @relation(fields: [pedidoVersionItemId], references: [id])
  createdById         Int?                  @map("created_by")
  createdBy           User?                 @relation(fields: [createdById], references: [id])
  createdAt           DateTime              @default(now()) @map("created_at")

  rolls        ProductionRoll[]
  attachments  ProductionOrderAttachment[]
  qualityCheck QualityCheck?

  @@map("production_orders")
}

/// Control de calidad de una OP final (Sellado/Precorte): se registra una
/// sola vez, al cerrarse la OP. Si es "rechazado", la OP queda "detenida" y
/// no se genera la entrada de inventario (ver productionOrders.ts, endpoint
/// POST /:id/quality-check).
model QualityCheck {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @unique @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  result            QualityResult
  observations      String?
  createdById       Int?            @map("created_by")
  createdBy         User?           @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("quality_checks")
}

/// Fila del registro acumulativo de rollos/bultos de una OP (la tabla
/// inferior de los formatos en papel: fecha, turno, operario, máquina,
/// etiqueta, peso, desperdicio). Lo que varía entre estaciones (pruebas
/// SI/NO, color, densidad, paq×unid, etiqueta/peso de origen, etc.) va en
/// `details` como JSON, para no tener 4 tablas casi idénticas.
/// `sourceRollId` es el rollo físico que se tomó como insumo (se llena
/// escaneando el QR pegado a ese rollo, ver POST /:id/rolls) — como quien
/// escanea es quien está logueado, queda registrado qué persona lo tomó sin
/// tener que preguntar.
model ProductionRoll {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  date              DateTime        @default(now())
  shift             String?
  operatorName      String          @map("operator_name")
  machine           String?
  label             String?
  weightKg          Decimal         @map("weight_kg") @db.Decimal(12, 2)
  wasteKg           Decimal         @default(0) @map("waste_kg") @db.Decimal(12, 2)
  details           Json?
  notes             String?
  sourceRollId      Int?             @map("source_roll_id")
  sourceRoll        ProductionRoll?  @relation("RollSource", fields: [sourceRollId], references: [id])
  consumedBy        ProductionRoll[] @relation("RollSource")
  createdById       Int?            @map("created_by")
  createdBy         User?           @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("production_rolls")
}

/// Adjuntos de una OP (fotos del rollo, fichas técnicas, artes de impresión).
/// Espejo del patrón de PedidoAttachment; los archivos viven en
/// uploads/produccion (ver routes/productionOrders.ts).
model ProductionOrderAttachment {
  id                Int             @id @default(autoincrement())
  productionOrderId Int             @map("production_order_id")
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  storedName        String          @map("stored_name")
  originalName      String          @map("original_name")
  mimeType          String          @map("mime_type")
  sizeBytes         Int             @map("size_bytes")
  uploadedById      Int?            @map("uploaded_by")
  uploadedBy        User?           @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("production_order_attachments")
}

/// Cotización comercial. No tiene versionamiento formal (a diferencia de
/// Pedido) porque el roadmap solo pide versionar pedidos — una cotización
/// se edita en el lugar hasta que se acepta o se convierte en Pedido.
model Cotizacion {
  id          Int               @id @default(autoincrement())
  quoteNumber String            @unique @map("quote_number")
  clientId    Int               @map("client_id")
  client      Client            @relation(fields: [clientId], references: [id])
  status      CotizacionStatus  @default(borrador)
  validUntil  DateTime?         @map("valid_until")
  notes       String?
  createdById Int?              @map("created_by")
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")

  items   CotizacionItem[]
  pedidos Pedido[]

  @@map("cotizaciones")
}

model CotizacionItem {
  id           Int        @id @default(autoincrement())
  cotizacionId Int        @map("cotizacion_id")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @map("unit_price") @db.Decimal(12, 2)
  measure      String?

  @@map("cotizacion_items")
}

/// Pedido (orden de venta). La identidad del pedido (número, cliente) vive
/// acá; el contenido real (ítems, precios, estado en ese momento) vive en
/// PedidoVersion — cada edición relevante crea una versión nueva completa
/// (v1, v2, v3...) en vez de sobrescribir la anterior, para poder navegar
/// el historial completo tal como pidió Steban.
model Pedido {
  id             Int      @id @default(autoincrement())
  orderNumber    String   @unique @map("order_number")
  clientId       Int      @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id])
  cotizacionId   Int?     @map("cotizacion_id")
  cotizacion     Cotizacion? @relation(fields: [cotizacionId], references: [id])
  /// Se mantienen desnormalizados acá (además de vivir en la versión
  /// vigente) para poder listar/filtrar pedidos sin tener que buscar
  /// primero cuál es la última versión de cada uno.
  status         PedidoStatus @default(borrador)
  currentVersion Int      @default(1) @map("current_version")
  createdById    Int?     @map("created_by")
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  versions    PedidoVersion[]
  attachments PedidoAttachment[]
  facturas    Factura[]

  @@map("pedidos")
}

model PedidoVersion {
  id            Int          @id @default(autoincrement())
  pedidoId      Int          @map("pedido_id")
  pedido        Pedido       @relation(fields: [pedidoId], references: [id])
  versionNumber Int          @map("version_number")
  status        PedidoStatus
  notes         String?
  createdById   Int?         @map("created_by")
  createdBy     User?        @relation(fields: [createdById], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")

  items PedidoVersionItem[]

  @@unique([pedidoId, versionNumber])
  @@map("pedido_versions")
}

model PedidoVersionItem {
  id              Int           @id @default(autoincrement())
  pedidoVersionId Int           @map("pedido_version_id")
  pedidoVersion   PedidoVersion @relation(fields: [pedidoVersionId], references: [id])
  productId       Int           @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  measure         String?

  productionOrder ProductionOrder?

  @@map("pedido_version_items")
}

/// Adjuntos del pedido (PDF, Excel, fichas técnicas, planos, fotos).
/// Se guardan en disco bajo server/uploads/pedidos/ (ver routes/pedidos.ts);
/// acá solo queda el metadato para listarlos/descargarlos.
model PedidoAttachment {
  id           Int      @id @default(autoincrement())
  pedidoId     Int      @map("pedido_id")
  pedido       Pedido   @relation(fields: [pedidoId], references: [id])
  storedName   String   @map("stored_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedById Int?     @map("uploaded_by")
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("pedido_attachments")
}

/// Factura de venta. Puede nacer de un Pedido (copiando sus ítems) o crearse
/// suelta (cliente + ítems directo) — ambos caminos quedan habilitados.
/// `status` se recalcula solo según los pagos registrados (ver routes/facturas.ts),
/// excepto "anulada" que es una acción manual.
model Factura {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number")
  clientId      Int           @map("client_id")
  client        Client        @relation(fields: [clientId], references: [id])
  pedidoId      Int?          @map("pedido_id")
  pedido        Pedido?       @relation(fields: [pedidoId], references: [id])
  status        FacturaStatus @default(emitida)
  notes         String?
  dueDate       DateTime?     @map("due_date")
  createdById   Int?          @map("created_by")
  createdBy     User?         @relation(fields: [createdById], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")

  items    FacturaItem[]
  payments Payment[]

  @@map("facturas")
}

model FacturaItem {
  id         Int     @id @default(autoincrement())
  facturaId  Int     @map("factura_id")
  factura    Factura @relation(fields: [facturaId], references: [id])
  productId  Int     @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(12, 2)
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  measure    String?

  @@map("factura_items")
}

/// Un pago (abono) contra una factura. Varios pagos pueden acumularse hasta
/// cubrir el total — el saldo pendiente de "Cartera" sale de sumar estos
/// montos y restárselos al total facturado (ver clients.ts /:id/cartera).
model Payment {
  id          Int           @id @default(autoincrement())
  facturaId   Int           @map("factura_id")
  factura     Factura       @relation(fields: [facturaId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  paidAt      DateTime      @default(now()) @map("paid_at")
  notes       String?
  createdById Int?          @map("created_by")
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

/// Token de un solo uso para "olvidé mi contraseña". Se guarda hasheado
/// (igual que la contraseña) para que un dump de la base no alcance para
/// resetear cuentas ajenas — el valor plano solo existe en el link del email.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

/// Clave/valor para estado interno de la app. Se usa para recordar cuándo se
/// hizo el último reseteo semanal del contador de visitas de clientes
/// (filtro "Frecuentes"), ver server/src/services/frecuentesReset.ts.
model AppMeta {
  key   String @id
  value String

  @@map("app_meta")
}
